# Loopback development defaults are intentionally disposable.
BITTERGIT_HOST=127.0.0.1
BITTERGIT_PORT=7420
BITTERGIT_DATA_ROOT=.var/bittergit

# Required, distinct, non-placeholder values for any non-loopback bind.
# Generate each independently, for example with: openssl rand -hex 32
BITTERGIT_DEV_TOKEN=
BITTERGIT_ASSERTION_SECRET=

# The demo UI is loopback-only.
BITTERGIT_ENABLE_DEMO_UI=true

# Network-bound local-path imports are confined here.
BITTERGIT_ARTIFACT_IMPORT_ROOT=.var/bittergit/imports
