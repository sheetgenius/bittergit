{
  "name": "bittergit",
  "version": "0.1.0",
  "description": "Open-source, self-hosted Git service for AI coding agents",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetgenius/bittergit.git"
  },
  "homepage": "https://bittergit.com/",
  "bugs": {
    "url": "https://github.com/sheetgenius/bittergit/issues"
  },
  "keywords": [
    "agentic-coding",
    "ai-agents",
    "git",
    "git-server",
    "self-hosted",
    "source-control",
    "source-custody"
  ],
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "check:shell": "bash -n scripts/*.sh",
    "smoke:phase1": "scripts/smoke-phase-1.sh",
    "verify": "scripts/verify.sh"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
